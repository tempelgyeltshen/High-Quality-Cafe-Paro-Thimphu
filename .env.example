# PORT: Port where the backend server runs (defaults to 3000).
PORT=3000

# APP_URL: The base URL where this applet is hosted.
# In production, AI Studio automatically sets this to the Cloud Run service URL.
# Used for QR code generation linking to table menus.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional Gemini API key if AI assistance is enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
