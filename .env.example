# NODE_ENV: Set to "production" in production deployments ("development" locally).
NODE_ENV=development

# PORT: Port where the Express + SPA server listens (defaults to 3000).
PORT=3000

# APP_URL: Public base URL where this application is hosted.
# Used when generating printable table QR codes (/menu?table=T01&token=...).
# If omitted, falls back automatically to the incoming request host.
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional server-side key (not required for core café ordering, KDS, or POS).
GEMINI_API_KEY=""
